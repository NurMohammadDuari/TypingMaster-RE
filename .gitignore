# ── Editor / IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── OS noise ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime transients (generated by Wine at launch) ──────────
# NOTE: runtime/ and prefix/ are INTENTIONALLY tracked in this repo.
# Only genuinely transient, regenerated files are ignored here.
*.log
wine-*.log
prefix/drive_c/windows/temp/
prefix/drive_c/users/*/Temp/
prefix/drive_c/users/*/Recent/
*.tmp

# ── Python (analysis scripts) ─────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Ghidra project scratch ────────────────────────────────────
*.gpr
*.rep/
ghidra_project*/

# ── Local build output ────────────────────────────────────────
/build/
/dist/
